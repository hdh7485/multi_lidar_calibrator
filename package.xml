<?xml version="1.0"?>
<package format="3">
  <name>multi_lidar_calibrator</name>
  <version>1.10.0</version>
  <description>The multi_lidar_calibrator package obtains extrinsic calibration between two lidar sensors.</description>

  <maintainer email="abrahammonrroy@yahoo.com">amc-nu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>message_filters</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
